# Copy to .env.local (Vite's convention, already gitignored) and fill in
# for a PRODUCTION build only - local dev needs nothing here, since
# vite.config.js proxies /api/* to the backend automatically.
#
# Set as an environment variable in your hosting dashboard (Vercel/
# Netlify) instead, if deploying there - Vite bakes VITE_ vars in at
# BUILD time, not runtime, so it must be set before the build runs.
VITE_API_URL=https://your-api.onrender.com
