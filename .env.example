# Copy this file to .env and fill in real values. .env is gitignored.

# --- Database (used by docker-compose and the Python app) ---
DB_USER=currency_app
DB_PASSWORD=change_me_dev_password
DB_NAME=currency_predictor
DB_PORT=5432
DB_HOST=localhost

# Full connection string, built from the above for local dev:
DATABASE_URL=postgresql://currency_app:change_me_dev_password@localhost:5432/currency_predictor

# --- Data source API keys (fill in as we add each source) ---
# EXCHANGE_RATE_API_KEY=
# NEWS_API_KEY=

# Free key from https://fredaccount.stlouisfed.org/apikeys - used for
# Indonesia's interest-rate series (Malaysia's comes from Bank Negara
# Malaysia's own public API, which needs no key).
FRED_API_KEY=
